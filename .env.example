# ╔══════════════════════════════════════════════════════════════════════╗
# ║                   RAKSHAK AI — ENVIRONMENT TEMPLATE                  ║
# ║  Copy this file to .env and fill in your Twilio and Tunnel details  ║
# ╚══════════════════════════════════════════════════════════════════════╝

# Twilio Credentials (from https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Phone Numbers (E.164 format with country code)
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
DEMO_TO_NUMBER=+91xxxxxxxxxx

# Public Webhook Base URL (Cloudflare Tunnel or ngrok)
BASE_URL=https://your-tunnel-subdomain.trycloudflare.com
